{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calm-badger",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calm-badger-db",
      "database_id": "9c2f505c-f55c-455d-b287-7e00b4e81244",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "calm-badger-artifacts",
    },
  ],
  "workflows": [
    {
      "binding": "RFQ_WORKFLOW",
      "name": "calm-badger-workflow",
      "class_name": "RfqWorkflow",
    },
  ],
  "vars": {
    "APP_ENV": "production",
    // "mistral" is the live reader. "contract-fake" is the deterministic
    // provider used by tests and fixture evaluation; it refuses to run when
    // APP_ENV is production.
    "OCR_PROVIDER": "mistral",
    "MISTRAL_OCR_MODEL": "mistral-ocr-latest",
    "OCR_COST_PER_1000_PAGES_USD": "1",
    // "openrouter" is the live extractor. "contract-fake" is the deterministic
    // provider used by tests and fixture evaluation; it refuses to run when
    // APP_ENV is production.
    "EXTRACTION_PROVIDER": "openrouter",
    "OPENROUTER_EXTRACTION_MODEL": "openai/gpt-5.6-luna",
    // "openrouter" is the live reranker. "contract-fake" is the deterministic
    // provider used by tests and fixture evaluation; it refuses to run when
    // APP_ENV is production.
    "RERANK_PROVIDER": "openrouter",
    "OPENROUTER_RERANK_MODEL": "openai/gpt-5.6-luna",
    // Demo heuristics, not calibrated probabilities: a reranked line is
    // accepted only when the winner scores at least MATCH_WINNER_STRENGTH and
    // leads the runner-up by at least MATCH_WINNER_GAP.
    "MATCH_WINNER_STRENGTH": "0.55",
    "MATCH_WINNER_GAP": "0.12",
    // How long an owner has to decide a review before it expires. The window
    // mirrors run retention, so a review never outlives the data it decides:
    // curated sample runs live seven days, custom uploads twenty-four hours.
    "REVIEW_WINDOW_SECONDS_CURATED": "604800",
    "REVIEW_WINDOW_SECONDS_CUSTOM": "86400",
    "OPENROUTER_COST_PER_1M_INPUT_TOKENS_USD": "1.25",
    "OPENROUTER_COST_PER_1M_OUTPUT_TOKENS_USD": "10",
    // Cookieless, server-side capture against EU ingestion. "contract-fake" is
    // the deterministic recorder tests read back and, like the other fakes, is
    // refused when APP_ENV is production; "none" disables measurement. With
    // "posthog" and no POSTHOG_API_KEY, capture is a no-op rather than an error.
    "ANALYTICS_PROVIDER": "posthog",
    "POSTHOG_HOST": "https://eu.i.posthog.com",
  },
  // The daily retention sweep. It deletes private R2 artifacts before it
  // cascades D1, is bounded to one batch, and picks an interrupted cleanup up
  // on the next schedule. The R2 lifecycle rule on the `runs/` prefix (added by
  // scripts/setup-infrastructure.sh, since lifecycle rules are an account-side
  // bucket setting rather than Worker configuration) is the safety net beneath
  // it for objects whose D1 row is already gone.
  "triggers": {
    "crons": ["23 3 * * *"],
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
