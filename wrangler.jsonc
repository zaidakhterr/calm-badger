{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "calm-badger",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-11",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "calm-badger-db",
      "database_id": "9c2f505c-f55c-455d-b287-7e00b4e81244",
      "migrations_dir": "./migrations",
    },
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "calm-badger-artifacts",
    },
  ],
  "workflows": [
    {
      "binding": "RFQ_WORKFLOW",
      "name": "calm-badger-workflow",
      "class_name": "RfqWorkflow",
    },
  ],
  "vars": {
    "APP_ENV": "production",
    "MISTRAL_OCR_MODEL": "mistral-ocr-latest",
    "OPENROUTER_EXTRACTION_MODEL": "openai/gpt-5.6-luna",
    "OPENROUTER_RERANK_MODEL": "openai/gpt-5.6-luna",
    "POSTHOG_HOST": "https://eu.i.posthog.com",
  },
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1,
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01,
    },
  },
}
