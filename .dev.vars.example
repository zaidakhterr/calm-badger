# Copy to .dev.vars for local development. Never commit real values.
# This override keeps local traffic out of the production analytics project.
APP_ENV=development
LANGFUSE_PROVIDER=none

MISTRAL_API_KEY=
OPENROUTER_API_KEY=
POSTHOG_API_KEY=
RATE_LIMIT_SALT=

# Langfuse prompts, scores, and tracing. Leave all three blank when disabled.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_BASE_URL=
